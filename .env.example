# =============================================================================
# GamePort — contoh konfigurasi
#   cp .env.example .env   lalu isi password-nya
# File .env yang asli TIDAK boleh di-commit (sudah ada di .gitignore).
# =============================================================================

# ---------- PostgreSQL ----------
# Di docker compose, DB adalah layanan bernama "db" pada network internal.
GAMEDB_HOST=db
GAMEDB_PORT=5432
GAMEDB_NAME=gamedb
GAMEDB_USER=gameport
# WAJIB diisi. Pakai password kuat; karakter khusus aman (di-escape otomatis).
GAMEDB_PASSWORD=

# ---------- Backend ----------
# Port publik (bind ke localhost secara default)
APP_PORT=8181
# Set 0.0.0.0 bila ingin diakses dari luar mesin
APP_BIND=127.0.0.1
# Origin yang diizinkan memanggil API, pisahkan koma. "*" = semua.
CORS_ORIGINS=*

# ---------- Opsional ----------
# Timeout HTTP dalam detik
# HTTP_READ_TIMEOUT=15
# HTTP_WRITE_TIMEOUT=30