# =============================================================================
# GamePort — contoh konfigurasi
#   cp .env.example .env  lalu isi nilainya
# File .env yang asli JANGAN di-commit (sudah ada di .gitignore).
#
# Di produksi, .env hanya ada di server (deploy dir), tidak pernah ikut
# GitHub Release / artifact. deploy/deploy.sh tidak pernah membuat atau
# menimpanya.
#
# Frontend publik dilayani Vercel. Backend hanya melayani API + panel admin,
# jadi STATIC_DIR cukup berisi admin.html, admin.css, admin.js.
# =============================================================================

# ---------- Database ----------
# Untuk dev / Docker Compose (PostgreSQL lewat TCP)
GAMEDB_NAME=gamedb
GAMEDB_USER=gameport
GAMEDB_PASSWORD=GANTI_PASSWORD_KUAT
GAMEDB_HOST=127.0.0.1
GAMEDB_PORT=5432

# Alternatif: pakai DSN utuh (menimpa variabel GAMEDB_* di atas).
# Nilai berisi & atau ? WAJIB dikutip karena .env di-source oleh bash.
# DATABASE_URL='postgres://user:pass@host:5432/dbname?sslmode=disable'

# Produksi di container Hermes: PostgreSQL hanya lewat unix socket.
# DATABASE_URL='postgres://gameport:GANTI_PASSWORD_KUAT@/gamedb?host=/opt/data/gameport/run&sslmode=disable'

# ---------- Server ----------
APP_HOST=0.0.0.0
APP_PORT=8181
STATIC_DIR=./static
# Hanya untuk menyajikan gambar lama dari fitur unggah yang sudah dihapus.
UPLOAD_DIR=./uploads

# Origin frontend yang boleh memanggil API (dipisah koma).
# Frontend terpisah di Vercel = origin-nya harus eksplisit di sini.
# Jangan pakai "*" di produksi.
CORS_ORIGINS=https://gameport.web.id,https://www.gameport.web.id,https://vps.gameport.web.id

# Origin publik untuk URL absolut di sitemap.xml (tanpa garis miring di akhir).
PUBLIC_URL=https://gameport.web.id

# ---------- Admin ----------
# WAJIB. Server menolak start bila kosong.
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN
# Path panel admin — sengaja acak supaya tidak mudah ditebak.
ADMIN_PATH=/panel-x7k2

# Opsional: isi hash SHA-256 untuk menghindari plaintext di .env
# ADMIN_PASSWORD_HASH=

# ---------- Safelink (gerbang iklan sebelum unduhan) ----------
# false = unduhan langsung seperti sekarang. Isi true untuk mengaktifkan.
SAFELINK_ENABLED=false
# Detik tunggu di halaman gerbang (dihitung di server, bukan timer JS)
SAFELINK_WAIT=10
# Umur token unduhan, detik
SAFELINK_TTL=300
